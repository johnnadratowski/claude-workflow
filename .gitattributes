# Generated artifacts: never textually merge (no conflicts). docs/TODO.md is
# re-derived from committed source (docs/todos/*.md) by
# `node .claude/scripts/gen-todos.mjs`.
#
# `merge=ours` keeps the current branch's version on a both-sided merge (no
# conflict, no disk read). Correctness is restored by the post-merge regenerate
# baked into the fleet's merge paths (the shared `regen_merged_artifacts` helper
# in base-push/base-merge/base-test) for docs/TODO.md.
#
# IMPORTANT: `merge=ours` is INERT without the driver being registered per clone
# (`git config merge.ours.driver true`) — it is NOT a git default. Run
# `.claude/scripts/setup-git-merge-drivers.sh` once per clone to register it
# (wire it into your project's own prepare/postinstall — see README.md). A clone
# whose driver isn't registered falls back to a normal (possibly-conflicting)
# merge — safe, not silently wrong.
docs/TODO.md merge=ours

# Set-semantics files: union-merge so an add/add conflict auto-keeps BOTH sides
# — the right resolution for an unordered set of ignore patterns (a line added
# on each branch is two independent additions, not a disagreement). `union` is a
# git BUILT-IN driver, so it needs NO per-clone registration (unlike merge=ours
# above) — it just works on everyone's next merge. NOT for code (union blindly
# concatenates both sides into something broken) — set/append-only files only.
.gitignore                                            merge=union
