# macOS
.DS_Store

# Editor swap files
*.swp
*~

# Claude Code harness runtime artifacts (lock/state files written under .claude/,
# not source — e.g. the scheduled-tasks/routines lock). The rest of .claude/ is tracked.
.claude/scheduled_tasks.lock
.claude/*.lock

# Per-clone workflow overrides (per-engineer/per-machine, NOT shared) — e.g.
# WORKFLOW_TODO_NS. Sourced after the committed .claude/workflow.config.
.claude/workflow.config.local

# Per-engineer local Claude settings (personal allow-list). Shared safety guardrails +
# machinery grants live in the committed .claude/settings.json (from settings.json.example);
# the personal file is local-only. Template: .claude/settings.local.json.example (seeded by /base-setup).
.claude/settings.local.json
